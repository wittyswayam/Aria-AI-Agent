# ARIA Personal AI Agent — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git (it's in .gitignore).

# ─── Anthropic ────────────────────────────────────────────────
# Get your key at https://console.anthropic.com
# Required for the backend proxy approach (see docs/EXTENDING.md)
ANTHROPIC_API_KEY=sk-ant-...

# ─── Google APIs (optional — for real Gmail/Calendar) ─────────
# Create credentials at https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/callback

# ─── App Settings ─────────────────────────────────────────────
PORT=8080
NODE_ENV=development
